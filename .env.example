# === AETERNA LOVETS — Environment Configuration ===
# Copy this file to .env and fill in your values

# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Telegram VIP Channel ID (the channel where deal alerts are sent)
# Create a channel, add the bot as admin, then get the channel ID
TELEGRAM_VIP_CHANNEL_ID=-1001234567890

# Scraper Settings
SCAN_INTERVAL_SECONDS=10
PRICE_DISCOUNT_THRESHOLD=20

# OLX.bg Settings
OLX_ENABLED=true
OLX_CATEGORIES=cars,electronics,properties

# Mobile.bg Settings  
MOBILEBG_ENABLED=true
MOBILEBG_MIN_YEAR=2005

# Imot.bg Settings
IMOTBG_ENABLED=true
IMOTBG_CITIES=sofia,plovdiv,varna,burgas
